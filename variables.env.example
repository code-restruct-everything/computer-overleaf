# 复制为 variables.env 后再填写，不要把真实的 variables.env 提交到版本库。
#   cp variables.env.example variables.env

OVERLEAF_APP_NAME="局域网 Overleaf"

# 局域网访问地址，用于邮件/邀请链接里拼 URL。没有域名就直接写 IP。
OVERLEAF_SITE_URL=http://192.168.3.11

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true

# 邀请制注册：不开放公开注册页，账号只能由管理员通过
# `podman exec -it overleaf node modules/server-ce-scripts/scripts/create-user.mjs --email=...`
# 或 Admin Panel 创建/邀请。这里禁用邮箱确认，因为没配置 SMTP 时确认邮件发不出去。
EMAIL_CONFIRMATION_DISABLED=true

# 用 `openssl rand -base64 32` 生成一次，写死在 variables.env 里，不要改动
# （改动会让已发出的邀请链接失效）。
OVERLEAF_INVITE_TOKEN_SECRET=

# 可选：设置后台管理员邮箱（用 create-user.mjs 建号时可以指定 --admin）
# OVERLEAF_ADMIN_EMAIL=admin@example.com

# 可选：SMTP，用于发邀请邮件/密码重置邮件。局域网内也可以不配，管理员建号后
# 直接把 Admin Panel 里生成的邀请链接手动转发给对方。
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=
# OVERLEAF_EMAIL_FROM_ADDRESS=team@example.com

# 未启用：本次部署不挂 docker.sock，不跑 Sandboxed Compiles（sibling
# containers），编译进程和 web 进程在同一个容器里。仅适合可信局域网用户，
# 详见 README.md。要打开的话再补齐这些变量：
# SANDBOXED_COMPILES=true
# TEXLIVE_IMAGE=quay.io/sharelatex/texlive-full:2025.1
